---
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/r3.css';
import Hero from '../components/Hero.astro';
import FeaturedWriting from '../components/FeaturedWriting.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import { assets } from '../data/assets';
import { describePhotograph } from '../data/gallery';
import { links, ventureCards } from '../data/links';
import { specialties } from '../data/portfolio';
---
<MainLayout
  title="Corrine J Blackthorn"
  description="Explore the cybersecurity, writing, photography, music, and advocacy work of Corrine J. Blackthorn."
>
  <Hero
    image={assets.hero}
    title="Corrine J Blackthorn"
    kicker="Technologist. Writer. Creator. Advocate."
    description="Systems thinking, creativity, and a commitment to making technology and the world around us more human."
    primaryHref="/technology/"
    primaryLabel="Explore my work"
    secondaryHref="/writing/"
    secondaryLabel="Read my writing"
  />

  <section class="content-section" aria-labelledby="professional-heading">
    <div class="container">
      <div class="section-heading">
        <span class="kicker">Professional work</span>
        <h2 id="professional-heading">Security is a system of decisions and trust.</h2>
        <p>I work across identity and access management, security governance, architecture, and practical improvements that make complicated systems safer and easier to understand. The best controls must work for people, not just on paper.</p>
      </div>
      <div class="grid">
        {specialties.slice(0, 3).map(area => (
          <article class="card compact-card"><h3>{area.title}</h3><p>{area.description}</p></article>
        ))}
      </div>
      <div class="section-actions">
        <a class="button dark" href="/technology/">Cybersecurity portfolio</a>
        <a class="button" href="/experience/">Experience and resume</a>
      </div>
    </div>
  </section>

  <section class="content-section section-soft" aria-labelledby="writing-heading">
    <div class="container">
      <div class="section-heading">
        <span class="kicker">Featured writing</span>
        <h2 id="writing-heading">Stories, systems, and the questions between them.</h2>
        <p>My writing moves between personal experience, technical questions, and advocacy. I examine what is happening, why it matters, and what deserves to change.</p>
      </div>
      <FeaturedWriting limit={3} />
      <div class="section-actions">
        <a class="button dark" href="/writing/">Explore selected writing</a>
        <a class="button" href={links.ventures.blackthornFieldNotes} target="_blank" rel="noopener noreferrer">Blackthorn Field Notes</a>
      </div>
    </div>
  </section>

  <section class="content-section" aria-labelledby="creative-heading">
    <div class="container">
      <div class="section-heading">
        <span class="kicker">Photography and music</span>
        <h2 id="creative-heading">Another way of telling stories.</h2>
        <p>Photography encourages me to notice what is easily missed. Music gives shape to experiences that can be difficult to explain another way.</p>
      </div>
      <div class="creative-layout">
        <div>
          <div class="gallery featured-gallery">
            {assets.photography.slice(0, 4).map(src => (
              <figure>
                <OptimizedImage source={src} alt={describePhotograph(src).alt} sizes="(max-width: 860px) 100vw, 32vw" loading="lazy" />
                {describePhotograph(src).caption && <figcaption>{describePhotograph(src).caption}</figcaption>}
              </figure>
            ))}
          </div>
          <div class="section-actions"><a class="button" href="/photography/">Explore photography</a></div>
        </div>
        <article class="card music-feature">
          <div class="image-frame">
            <OptimizedImage source={assets.brandImages.glassAndThorns} alt="Glass & Thorns artist project artwork" sizes="(max-width: 860px) 100vw, 35vw" loading="lazy" />
          </div>
          <h3>Glass & Thorns</h3>
          <p>Music exploring identity, transformation, resilience, and the search for a voice.</p>
          <a class="button" href="/music/">Discover the music</a>
        </article>
      </div>
    </div>
  </section>

  <section class="content-section section-soft" aria-labelledby="story-heading">
    <div class="container split">
      <div class="portrait-frame">
        <OptimizedImage source={assets.portraits[5]} alt="Corrine J. Blackthorn wearing glasses and a gray hoodie" sizes="(max-width: 860px) 100vw, 42vw" loading="lazy" />
      </div>
      <div>
        <span class="kicker">My story and advocacy</span>
        <h2 id="story-heading">Compassion is something we practice.</h2>
        <p>I am more than one title or creative project. My experiences shape how I approach belonging, resilience, access, and the responsibility we have to one another.</p>
        <p>I believe the systems people depend on should make room for human complexity, not punish it.</p>
        <div class="section-actions">
          <a class="button dark" href="/about/">Read my story</a>
          <a class="button" href="/advocacy/">Advocacy</a>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section" aria-labelledby="connection-heading">
    <div class="container">
      <div class="section-heading">
        <span class="kicker">Projects and connections</span>
        <h2 id="connection-heading">Different paths. A shared perspective.</h2>
        <p>These are some of the places where the work lives. Explore the broader portfolio, follow the writing, or connect about a professional or creative collaboration.</p>
      </div>
      <div class="link-list">
        {ventureCards.map(venture => (
          <a class="link-card" href={venture.href} target="_blank" rel="noopener noreferrer">
            <span class="feature-category">{venture.category}</span>
            <h3>{venture.title}</h3>
            <p>{venture.description}</p>
          </a>
        ))}
      </div>
      <div class="section-actions">
        <a class="button dark" href="/projects/">All projects</a>
        <a class="button" href={links.personal.linkedin} target="_blank" rel="noopener noreferrer">Connect on LinkedIn</a>
        <a class="button" href={links.personal.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
  </section>
</MainLayout>
