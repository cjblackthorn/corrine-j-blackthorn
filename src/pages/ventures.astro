---
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/r3.css';
import { ventureCards, links } from '../data/links';
---
<MainLayout
  title="Ventures | Corrine J Blackthorn"
  description="Explore the organizations, creative projects, and professional ventures connected to Corrine J. Blackthorn."
>
  <section class="content-section"><div class="container">
    <div class="section-heading">
      <span class="kicker">Connected work</span>
      <h1>Ventures and creative homes.</h1>
      <p>These selected destinations represent the current public-facing writing, technical, music, and broader business portfolio. A listing here identifies a project or destination, not a promise that every product or service is currently available.</p>
    </div>
    <div class="link-list">
      {ventureCards.map(venture => (
        <a class="link-card" href={venture.href} target="_blank" rel="noopener noreferrer">
          <span class="feature-category">{venture.category}</span>
          <h2>{venture.title}</h2>
          <p>{venture.description}</p>
        </a>
      ))}
    </div>
  </div></section>
  <section class="content-section section-soft"><div class="container">
    <div class="section-heading"><span class="kicker">Professional connections</span><h2>Explore the people and ideas behind the work.</h2><p>For career opportunities, cybersecurity collaboration, or editorial inquiries, the best starting point is my professional profile. A dedicated contact page is planned separately.</p></div>
    <div class="section-actions"><a class="button dark" href={links.personal.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a><a class="button" href={links.personal.github} target="_blank" rel="noopener noreferrer">GitHub</a><a class="button" href="/projects/">Selected projects</a></div>
  </div></section>
</MainLayout>
