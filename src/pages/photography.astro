---
import MainLayout from '../layouts/MainLayout.astro';
import { assets } from '../data/assets';
import OptimizedImage from '../components/OptimizedImage.astro';
import { describePhotograph } from '../data/gallery';
---
<MainLayout
  title="Photography | Corrine J Blackthorn"
  description="Explore nature, portraits, changing light, and everyday moments through the photography of Corrine J. Blackthorn."
>
  <section>
    <div class="container">
      <div class="section-heading">
        <span class="kicker">Personal photography portfolio</span>
        <h1>Photography</h1>
        <p>Photography helps me slow down and notice the beauty hidden in ordinary moments.</p>
        <p>I photograph quiet moments, changing light, nature, food, people, and the details that often pass by unnoticed.</p>
      </div>
      <div class="gallery">
        {assets.photography.map((src) => (
          <figure>
            <OptimizedImage source={src} alt={describePhotograph(src).alt} sizes="(max-width: 860px) 100vw, 50vw" loading="lazy" />
            {describePhotograph(src).caption && <figcaption>{describePhotograph(src).caption}</figcaption>}
          </figure>
        ))}
      </div>
    </div>
  </section>
  <section class="quote-band"><div class="container"><blockquote>Quiet moments. Changing light. Everyday beauty.</blockquote></div></section>
</MainLayout>
