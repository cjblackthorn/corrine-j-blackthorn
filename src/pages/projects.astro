---
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/r3.css';
import { selectedProjects, links } from '../data/links';
---
<MainLayout
  title="Projects | Corrine J Blackthorn"
  description="Discover the active creative, technical, entrepreneurial, and advocacy projects associated with Corrine J. Blackthorn."
>
  <section class="content-section"><div class="container">
    <div class="section-heading">
      <span class="kicker">Selected projects</span>
      <h1>What I'm building, writing, and making.</h1>
      <p>Some projects are public and growing. Others are still taking shape. Each listing distinguishes published work, ongoing portfolios, and work in progress rather than suggesting everything is already a functioning service.</p>
    </div>
    <div class="grid">
      {selectedProjects.map(project => (
        <article class="card project-card">
          <span class="project-status">{project.status}</span>
          <h2>{project.title}</h2>
          <p>{project.description}</p>
          <a class="feature-link" href={project.href} rel={project.href.startsWith('http') ? 'noopener noreferrer' : undefined} target={project.href.startsWith('http') ? '_blank' : undefined}>Explore this work</a>
        </article>
      ))}
    </div>
  </div></section>
  <section class="content-section section-soft"><div class="container split">
    <div><span class="kicker">Technical work</span><h2>Identity governance, security, and systems thinking.</h2><p>My professional work includes identity and access management, engineering, risk, audit readiness, and the architecture behind maintainable access controls.</p><div class="section-actions"><a class="button dark" href="/technology/">View technical portfolio</a><a class="button" href={links.ventures.techNerd} target="_blank" rel="noopener noreferrer">TechNerd</a></div></div>
    <article class="card compact-card"><h3>Future and exploratory projects</h3><p>I prefer not to promote a future idea as an available service. Additional ventures and concepts will be added here after their names, purpose, links, and operating status have been confirmed.</p></article>
  </div></section>
  <section class="quote-band"><div class="container"><blockquote>Different projects. Shared values. Each one is another way to learn, create, understand, or connect.</blockquote></div></section>
</MainLayout>
